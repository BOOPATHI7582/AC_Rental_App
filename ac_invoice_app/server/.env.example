# Copy this file to .env and fill in your real values. Never commit .env.

# Your MongoDB Atlas connection string (Database → Connect → Drivers).
# Add a database name at the end (e.g. /ac_invoice_app) so everything lands
# in one place - Atlas creates it automatically on first write.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vlwqn2j.mongodb.net/ac_invoice_app?retryWrites=true&w=majority&appName=Cluster0

# Any long random string - used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

PORT=4000

# Comma-separated list of emails that should automatically become admins
# when they register (e.g. your own email). Admins can see every user and
# every invoice via the Admin Dashboard in the app.
ADMIN_EMAILS=you@example.com
